{
  "id": "vikunja-super-productivity-plugin",
  "name": "Vikunja",
  "version": "0.2.0",
  "description": "Super Productivity issue provider for Vikunja",
  "manifestVersion": 1,
  "minSupVersion": "19.2.0",
  "type": "issueProvider",
  "icon": "icon.svg",
  "permissions": [
    "http",
    "updateTask",
    "batchUpdateForProject",
    "getTasks",
    "getArchivedTasks",
    "getAllProjects",
    "addProject",
    "updateProject",
    "openDialog",
    "showSnack"
  ],
  "hooks": [
    "taskCreated",
    "taskUpdate"
  ],
  "iFrame": false,
  "issueProvider": {
    "allowPrivateNetwork": true,
    "pollIntervalMs": 300000,
    "defaultAutoAddToBacklog": true,
    "icon": "plugin-vikunja-super-productivity-plugin-icon",
    "humanReadableName": "Vikunja",
    "issueStrings": {
      "singular": "Task",
      "plural": "Tasks"
    }
  }
}
